APP_NAME=crm-python-backend
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
APP_PUBLIC_PORT=8000
DEBUG=true

POSTGRES_DB=crm_python_backend
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/crm_python_backend

SQL_ECHO=false

JWT_SECRET_KEY=test-secret-key-with-minimum-32-bytes
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

CORS_ALLOW_ORIGINS=*
ADMIN_TITLE=Study CRM Admin
ADMIN_BASE_URL=/admin
ADMIN_SESSION_SECRET=test-admin-session-secret
ADMIN_ALLOWED_EMAILS=
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=admin

# Для будущих ДЗ:
REDIS_URL=redis://localhost:6379/0
KAFKA_BROKERS=kafka:9092
ENABLE_METRICS=true
